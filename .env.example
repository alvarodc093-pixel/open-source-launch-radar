# Token de GitHub para la API GraphQL (solo lectura de repositorios públicos).
# Si se deja vacío se usa el de `gh auth token`; en GitHub Actions se usa el
# GITHUB_TOKEN del propio workflow.
GITHUB_TOKEN=

# Correo opcional para el User-Agent de las peticiones, por si alguna fuente
# necesita contactar si hay un problema.
CONTACTO_USER_AGENT=
