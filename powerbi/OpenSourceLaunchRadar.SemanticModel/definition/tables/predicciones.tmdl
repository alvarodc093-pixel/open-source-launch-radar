table predicciones
	lineageTag: 8f44ce8e-375c-53de-aefa-d7098c04fe17

	/// Lanzamientos más recientes, que el modelo no vio al entrenar.
	measure 'Paquetes de test' = DISTINCTCOUNT(predicciones[paquete])
		formatString: #,0
		lineageTag: 4c325646-3300-50b0-b651-5a94ce8003ff

	/// exp(mediana del error en log): ×1,36 es un 36 % de desviación.
	measure 'Factor de error típico' = ```
			VAR d = SELECTEDVALUE(lecturas[dia_lectura], 7)
			RETURN CALCULATE(EXP(MEDIAN(predicciones[error_log])), lecturas[dia_lectura] = d)
			```
		formatString: 0.00
		lineageTag: 03a2caf9-e8d1-5279-b784-94c91c57c206

	/// Paquetes cuyo valor real cae dentro del rango del 90 %.
	measure 'Cobertura del rango' = ```
			VAR d = SELECTEDVALUE(lecturas[dia_lectura], 7)
			RETURN CALCULATE(AVERAGE(predicciones[dentro_rango]), lecturas[dia_lectura] = d)
			```
		formatString: 0 %
		lineageTag: 27725411-6555-5699-9f28-9fc5849de348

	/// Estimaciones entre la mitad y el doble del valor real.
	measure 'Dentro de x2' = ```
			VAR d = SELECTEDVALUE(lecturas[dia_lectura], 7)
			RETURN CALCULATE(AVERAGEX(predicciones, IF(predicciones[error_log] <= LN(2), 1, 0)), lecturas[dia_lectura] = d)
			```
		formatString: 0 %
		lineageTag: b5e2bf88-4dc9-57a2-a905-90986063b634

	/// Descargas de usuario a 30 días que estimó el radar.
	measure 'Estimación' = ```
			VAR d = SELECTEDVALUE(lecturas[dia_lectura], 7)
			RETURN CALCULATE(AVERAGE(predicciones[estimacion]), lecturas[dia_lectura] = d)
			```
		formatString: #,0
		lineageTag: c57981b8-46aa-5f1a-9535-a885abcbb095

	/// Descargas de usuario que tuvo de verdad al cumplir 30 días.
	measure 'Descargas reales' = ```
			VAR d = SELECTEDVALUE(lecturas[dia_lectura], 7)
			RETURN CALCULATE(AVERAGE(predicciones[usuario_30d_reales]), lecturas[dia_lectura] = d)
			```
		formatString: #,0
		lineageTag: 2b7ff448-2bbc-57ba-b078-13c6bba8f173

	column paquete
		dataType: string
