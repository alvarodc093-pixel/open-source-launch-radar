table curva_diaria
	lineageTag: 2fb84b18-c176-50a7-ab9e-cf0980d7ce62

	/// Parte de las descargas de usuario del mes que ya ha llegado (mediana).
	measure '% del mes recibido' = MEDIAN(curva_diaria[fraccion_mes])
		formatString: 0 %
		lineageTag: bbe1a4f7-21db-59c6-9b63-7e37d4e5ea7f

	/// Lo mismo con las descargas totales, que saltan el día de cada subida.
	measure '% del mes recibido (totales)' = MEDIAN(curva_diaria[fraccion_mes_total])
		formatString: 0 %
		lineageTag: 204ed499-eece-5031-a464-54b0208993fa

	/// Parte del mes que ya ha llegado el día 7 (paquete mediano).
	measure 'Recibido día 7' = CALCULATE([% del mes recibido], curva_diaria[dia] = 7)
		formatString: 0 %
		lineageTag: 2794b36c-9582-5591-9673-2f3bc9a18723

	/// Parte del mes que ya ha llegado el día 14 (paquete mediano).
	measure 'Recibido día 14' = CALCULATE([% del mes recibido], curva_diaria[dia] = 14)
		formatString: 0 %
		lineageTag: aa1c1a2d-1ae3-5a11-bf8e-682b18a68967

	/// Parte del mes que ya ha llegado el día 21 (paquete mediano).
	measure 'Recibido día 21' = CALCULATE([% del mes recibido], curva_diaria[dia] = 21)
		formatString: 0 %
		lineageTag: 7d68f9e6-fce7-5efe-8396-706ecfb96954

	column paquete
		dataType: string
		isHidden
		lineageTag: de398871-b019-5b6f-b531-6bbe19a24a33
		summarizeBy: none
		sourceColumn: paquete

	column dia
		dataType: int64
		formatString: 0
		lineageTag: 7afacfdc-a71f-5050-a36b-e087b793d010
		summarizeBy: none
		sourceColumn: dia

	column usuario
		dataType: int64
		formatString: #,0
		lineageTag: 07dfc3a1-11ae-50c3-bf2a-e01af55c663c
		summarizeBy: none
		sourceColumn: usuario

	column total
		dataType: int64
		formatString: #,0
		lineageTag: 4751cb4d-a53d-5446-bc3a-f23ce2a57d65
		summarizeBy: none
		sourceColumn: total

	column usuario_acumulado
		dataType: int64
		formatString: #,0
		lineageTag: 9f655f48-cc49-574e-8d6f-9843d4317b96
		summarizeBy: none
		sourceColumn: usuario_acumulado

	column total_acumulado
		dataType: int64
		formatString: #,0
		lineageTag: 2e20b787-7a59-51b1-99d2-5b2108d2021a
		summarizeBy: none
		sourceColumn: total_acumulado

	column fraccion_mes
		dataType: double
		formatString: 0 %
		lineageTag: ac88d5d9-4584-5003-aab6-f4954a3b45b9
		summarizeBy: none
		sourceColumn: fraccion_mes

	column fraccion_mes_total
		dataType: double
		formatString: 0 %
		lineageTag: c3c3f674-558d-5d5f-affd-d08a2afd3d14
		summarizeBy: none
		sourceColumn: fraccion_mes_total

	partition curva_diaria = m
		mode: import
		source =
				let
				    Ruta = OrigenDatos & "curva_diaria.csv",
				    Contenido = if Text.StartsWith(Ruta, "http") then Web.Contents(Ruta) else File.Contents(Ruta),
				    Origen = Csv.Document(Contenido, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"paquete", type text}, {"dia", Int64.Type}, {"usuario", Int64.Type}, {"total", Int64.Type}, {"usuario_acumulado", Int64.Type}, {"total_acumulado", Int64.Type}, {"fraccion_mes", type number}, {"fraccion_mes_total", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
