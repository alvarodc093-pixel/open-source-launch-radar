	column conjunto
		dataType: string
		lineageTag: eb3ce750-59a4-5a24-a214-2c0e06ee6e07
		summarizeBy: none
		sourceColumn: conjunto

	partition paquetes = m
		mode: import
		source =
				let
				    Ruta = OrigenDatos & "paquetes.csv",
				    Contenido = if Text.StartsWith(Ruta, "http") then Web.Contents(Ruta) else File.Contents(Ruta),
				    Origen = Csv.Document(Contenido, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"paquete", type text}, {"nombre", type text}, {"repo", type text}, {"fecha_lanzamiento", type date}, {"categoria", type text}, {"propietario_tipo", type text}, {"estrellas", Int64.Type}, {"estado", type text}, {"estado_descripcion", type text}, {"usuario_30d", Int64.Type}, {"total_30d", Int64.Type}, {"pct_usuario_30d", type number}, {"subidas_30d", Int64.Type}, {"conjunto", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
