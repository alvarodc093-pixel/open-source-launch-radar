table paquetes
	lineageTag: 4e9891a1-a5ed-5573-9551-7dae9afc3427

	/// Paquetes nuevos de PyPI con un repositorio de 10 estrellas o más.
	measure 'Candidatos' = COUNTROWS(paquetes)
		formatString: #,0
		lineageTag: c85200a5-a006-538d-b660-c5a34fa7f854

	/// Paquetes que entran en el modelo tras la limpieza.
	measure 'Lanzamientos aptos' = CALCULATE(COUNTROWS(paquetes), paquetes[estado] = "apto")
		formatString: #,0
		lineageTag: 70e29bf5-0941-585f-bcdc-eaccbba0101c

	/// Parte de los candidatos que se excluye en el preprocesamiento.
	measure '% excluidos' = DIVIDE([Candidatos] - [Lanzamientos aptos], [Candidatos])
		formatString: 0.0 %
		lineageTag: 1e02fea5-53a3-547a-ab85-38fa960cc5c0

	/// Descargas de pip, uv, poetry… en el primer mes del paquete mediano.
	measure 'Mediana descargas de usuario 30 días' = CALCULATE(MEDIAN(paquetes[usuario_30d]), paquetes[estado] = "apto")
		formatString: #,0
		lineageTag: 3688df50-525f-58de-8ed4-39d663675181

	/// Descargas con mirrors y bots en el primer mes del paquete mediano.
	measure 'Mediana descargas totales 30 días' = CALCULATE(MEDIAN(paquetes[total_30d]), paquetes[estado] = "apto")
		formatString: #,0
		lineageTag: 5b10ad54-194c-56d8-b227-76118b0b6363

	/// Parte de las descargas del primer mes que viene de usuarios.
	measure '% de usuario (mediana)' = CALCULATE(MEDIAN(paquetes[pct_usuario_30d]), paquetes[estado] = "apto")
		formatString: 0.0 %
		lineageTag: d2f8d361-d769-5acb-8886-34f8ea4f1f5b

	/// Estrellas de hoy del repositorio del paquete mediano.
	measure 'Mediana estrellas' = CALCULATE(MEDIAN(paquetes[estrellas]), paquetes[estado] = "apto")
		formatString: #,0
		lineageTag: 4bc8283b-5048-50ee-84eb-8eeb42d05ab7

	column paquete
